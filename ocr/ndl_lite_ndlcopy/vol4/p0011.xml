<PAGE IMAGENAME="p0011.jpg" WIDTH="4540" HEIGHT="4077">
  <LINE TYPE="本文" X="4206" Y="707" WIDTH="69" HEIGHT="314" CONF="0.530" ORDER="0" STRING="太良四四" />
  <LINE TYPE="本文" X="4112" Y="382" WIDTH="76" HEIGHT="1179" CONF="0.827" ORDER="1" STRING="つゞきふらんきりんがいへにかへりてことしか〳〵と" />
  <LINE TYPE="本文" X="4048" Y="379" WIDTH="75" HEIGHT="1181" CONF="0.812" ORDER="2" STRING="つぐるにぞきくもの身のけをいよだゝせりかくて" />
  <LINE TYPE="本文" X="3984" Y="381" WIDTH="75" HEIGHT="1172" CONF="0.818" ORDER="3" STRING="わしんとんはふらんきりんおやこのものゝあつき" />
  <LINE TYPE="本文" X="3924" Y="369" WIDTH="76" HEIGHT="1200" CONF="0.805" ORDER="4" STRING="もてなしをしやしつゝもわがふたおやのわれを" />
  <LINE TYPE="本文" X="3863" Y="374" WIDTH="75" HEIGHT="1195" CONF="0.846" ORDER="5" STRING="まちこゝろをらうさせゐまさんなればひとまづ" />
  <LINE TYPE="本文" X="3801" Y="375" WIDTH="75" HEIGHT="1185" CONF="0.819" ORDER="6" STRING="いへにたちかへりちかきにゆる〳〵おてれいにまかり" />
  <LINE TYPE="本文" X="3740" Y="391" WIDTH="76" HEIGHT="1118" CONF="0.803" ORDER="7" STRING="こさんしからばとていとまをつぐればおやこの" />
  <LINE TYPE="本文" X="3679" Y="391" WIDTH="73" HEIGHT="1132" CONF="0.808" ORDER="8" STRING="ものはいとゞなごりはをしめどもさてとゞむべき" />
  <LINE TYPE="本文" X="3620" Y="389" WIDTH="71" HEIGHT="1100" CONF="0.817" ORDER="9" STRING="にあらざればまたこそいらせ給はれとさい" />
  <LINE TYPE="本文" X="3555" Y="378" WIDTH="76" HEIGHT="1158" CONF="0.778" ORDER="10" STRING="くわいをやくしつゝいへのこにめいじいつてうの" />
  <LINE TYPE="本文" X="3490" Y="372" WIDTH="85" HEIGHT="1238" CONF="0.814" ORDER="11" STRING="車馬職をしゆつらいこれにわしんとんをうち" />
  <LINE TYPE="本文" X="3431" Y="373" WIDTH="76" HEIGHT="1226" CONF="0.833" ORDER="12" STRING="のせツゝあまたのさとびとにぜんごをかこませ" />
  <LINE TYPE="本文" X="3375" Y="372" WIDTH="73" HEIGHT="1219" CONF="0.809" ORDER="13" STRING="いとぎやう〴〵しくおくりいだすにすぐるちまた" />
  <LINE TYPE="本文" X="3316" Y="390" WIDTH="75" HEIGHT="1172" CONF="0.801" ORDER="14" STRING="のらうにやく男女はわしんとんをかいま見んと" />
  <LINE TYPE="本文" X="3253" Y="394" WIDTH="79" HEIGHT="1225" CONF="0.795" ORDER="15" STRING="そのみちすぢにたちいでてそれをけんぶつなす" />
  <LINE TYPE="本文" X="3198" Y="385" WIDTH="69" HEIGHT="1167" CONF="0.774" ORDER="16" STRING="ものゝいくたりといふかずをしらずかくまで" />
  <LINE TYPE="本文" X="3139" Y="380" WIDTH="74" HEIGHT="1226" CONF="0.807" ORDER="17" STRING="わしんとんはわがさとちかきところにて車馬を" />
  <LINE TYPE="本文" X="3079" Y="384" WIDTH="73" HEIGHT="1239" CONF="0.848" ORDER="18" STRING="をくだりておくりきたるひと〴〵をこゝよりかへし" />
  <LINE TYPE="本文" X="3016" Y="387" WIDTH="78" HEIGHT="1260" CONF="0.868" ORDER="19" STRING="これよりその身ひとりにてみちをはやめてふあ" />
  <LINE TYPE="本文" X="2955" Y="389" WIDTH="69" HEIGHT="994" CONF="0.841" ORDER="20" STRING="きすなるおのがいへぢにおもむきける" />
  <LINE TYPE="本文" X="2892" Y="402" WIDTH="69" HEIGHT="1159" CONF="0.829" ORDER="21" STRING="はなし一つにわかる「これはさておきこゝにまたどう" />
  <LINE TYPE="本文" X="2823" Y="399" WIDTH="74" HEIGHT="1217" CONF="0.766" ORDER="22" STRING="ごく。のるほるくといへるところに。あくだむす。と" />
  <LINE TYPE="本文" X="2763" Y="387" WIDTH="79" HEIGHT="1306" CONF="0.794" ORDER="23" STRING="いへるものありその身いとけなくしてちゝをうしなひ" />
  <LINE TYPE="本文" X="2704" Y="400" WIDTH="79" HEIGHT="1297" CONF="0.807" ORDER="24" STRING="はゝにつかへてかうしんふかくさんぎやうのいとまにははゝ" />
  <LINE TYPE="本文" X="2644" Y="389" WIDTH="77" HEIGHT="1327" CONF="0.800" ORDER="25" STRING="おやをなぐさめかしづきかりにもそりやくのふるまひ" />
  <LINE TYPE="本文" X="2577" Y="393" WIDTH="85" HEIGHT="1349" CONF="0.847" ORDER="26" STRING="なくかのもろこしの二十四のともがらにしもはづべからず" />
  <LINE TYPE="本文" X="2511" Y="392" WIDTH="80" HEIGHT="1286" CONF="0.840" ORDER="27" STRING="あゝだむす今とし十八といへるはるむそじにあまる" />
  <LINE TYPE="本文" X="2445" Y="394" WIDTH="80" HEIGHT="1276" CONF="0.874" ORDER="28" STRING="はゝおやはこしかゞみからだおとろへあゆみもじざい" />
  <LINE TYPE="本文" X="2041" Y="366" WIDTH="69" HEIGHT="1299" CONF="0.769" ORDER="29" STRING="ならざればたゞいへにのみとぢこもり身をなぐさむ" />
  <LINE TYPE="本文" X="1982" Y="353" WIDTH="70" HEIGHT="1335" CONF="0.787" ORDER="30" STRING="べきよすがなしころしもやよひなかのころにてよもの" />
  <LINE TYPE="本文" X="1919" Y="360" WIDTH="73" HEIGHT="1352" CONF="0.742" ORDER="31" STRING="やま〳〵はなさきていとふぜいあるけしきなりとほとりの" />
  <LINE TYPE="本文" X="1859" Y="350" WIDTH="72" HEIGHT="1356" CONF="0.761" ORDER="32" STRING="ものゝいへるをきゝある日はゝおやあゝだむすをちかく" />
  <LINE TYPE="本文" X="1805" Y="346" WIDTH="69" HEIGHT="1334" CONF="0.772" ORDER="33" STRING="まねぎていへるやう〽このせつよものやま〳〵ははなのさかり" />
  <LINE TYPE="本文" X="1744" Y="353" WIDTH="68" HEIGHT="1293" CONF="0.783" ORDER="34" STRING="ときくものをあしのはこびのよかりなばおひをなぐさむ" />
  <LINE TYPE="本文" X="1684" Y="364" WIDTH="68" HEIGHT="1288" CONF="0.774" ORDER="35" STRING="よすがにもかしこへいたりてはなを見んにあゆみのならぬ" />
  <LINE TYPE="本文" X="1626" Y="358" WIDTH="66" HEIGHT="1267" CONF="0.765" ORDER="36" STRING="かなしさにははなさくはるのながめさへよそに見すごす" />
  <LINE TYPE="本文" X="1564" Y="355" WIDTH="68" HEIGHT="1324" CONF="0.755" ORDER="37" STRING="らたてさよこれを思へば一ト日もはやくしするがましぞと" />
  <LINE TYPE="本文" X="1504" Y="353" WIDTH="67" HEIGHT="1304" CONF="0.752" ORDER="38" STRING="なみだくむおひのくりごときく身にもむねふたがりて" />
  <LINE TYPE="本文" X="1440" Y="653" WIDTH="69" HEIGHT="1068" CONF="0.589" ORDER="39" STRING="いとゞしくものかなしくぞきこへけるあくだ" />
  <LINE TYPE="本文" X="1385" Y="937" WIDTH="65" HEIGHT="791" CONF="0.733" ORDER="40" STRING="むすはこれをなぐさめ〽さははひ" />
  <LINE TYPE="本文" X="1332" Y="1113" WIDTH="59" HEIGHT="669" CONF="0.803" ORDER="41" STRING="けふはそらもはれひとしに" />
  <LINE TYPE="本文" X="1274" Y="1141" WIDTH="61" HEIGHT="655" CONF="0.771" ORDER="42" STRING="のどかのやうきにはべれば" />
  <LINE TYPE="本文" X="1215" Y="1200" WIDTH="58" HEIGHT="578" CONF="0.809" ORDER="43" STRING="はゝうへをおひたてまつ" />
  <LINE TYPE="本文" X="1156" Y="1210" WIDTH="58" HEIGHT="605" CONF="0.834" ORDER="44" STRING="りて。ほるつもうとのきた" />
  <LINE TYPE="本文" X="1095" Y="1207" WIDTH="64" HEIGHT="632" CONF="0.852" ORDER="45" STRING="やまへまかりてはなをながめ" />
  <LINE TYPE="本文" X="1041" Y="1205" WIDTH="58" HEIGHT="637" CONF="0.805" ORDER="46" STRING="はべらんしばらくまたせ" />
  <LINE TYPE="本文" X="983" Y="1206" WIDTH="67" HEIGHT="869" CONF="0.833" ORDER="47" STRING="給へかしわりごさゝへのよういせんと" />
  <LINE TYPE="本文" X="925" Y="1228" WIDTH="62" HEIGHT="843" CONF="0.802" ORDER="48" STRING="まめ〳〵しくたちはたらきようい" />
  <LINE TYPE="本文" X="863" Y="1236" WIDTH="66" HEIGHT="868" CONF="0.824" ORDER="49" STRING="たゞちにとゝのひければわりごさゝへを" />
  <LINE TYPE="本文" X="798" Y="1234" WIDTH="66" HEIGHT="836" CONF="0.810" ORDER="50" STRING="こしにつけはゝをそびらにうち" />
  <LINE TYPE="本文" X="735" Y="1229" WIDTH="68" HEIGHT="833" CONF="0.839" ORDER="51" STRING="おひてかのきたやまにつれゐたりひと" />
  <LINE TYPE="本文" X="674" Y="1225" WIDTH="68" HEIGHT="852" CONF="0.852" ORDER="52" STRING="けもあらぬところこそものしづか" />
  <LINE TYPE="本文" X="607" Y="1219" WIDTH="70" HEIGHT="847" CONF="0.830" ORDER="53" STRING="にてよかんめりとくいぜにはゝをこし" />
  <LINE TYPE="本文" X="549" Y="1246" WIDTH="64" HEIGHT="897" CONF="0.691" ORDER="54" STRING="かけさせとしにつけたるわりごさゝへを" />
  <LINE TYPE="本文" X="493" Y="1221" WIDTH="63" HEIGHT="850" CONF="0.720" ORDER="55" STRING="とりいだしてうちひらきこれをらう" />
  <LINE TYPE="本文" X="433" Y="1237" WIDTH="72" HEIGHT="938" CONF="0.787" ORDER="56" STRING="ぼにすゝめつゝやま〳〵にさきそふはなを" />
  <LINE TYPE="本文" X="370" Y="1256" WIDTH="73" HEIGHT="855" CONF="0.849" ORDER="57" STRING="ながめてしばしこれにをりかくて" />
  <LINE TYPE="本文" X="1225" Y="2748" WIDTH="54" HEIGHT="154" CONF="0.371" ORDER="58" STRING="はら" />
<LINE TYPE="本文" X="1157" Y="2780" WIDTH="68" HEIGHT="169" CONF="0.540" ORDER="59" STRING="おやは" />
  <LINE TYPE="本文" X="1104" Y="2602" WIDTH="66" HEIGHT="348" CONF="0.668" ORDER="60" STRING="けふのゆさんに" />
  <LINE TYPE="本文" X="1047" Y="2322" WIDTH="61" HEIGHT="670" CONF="0.401" ORDER="61" STRING="こゝろをなぐさめよろ" />
  <LINE TYPE="本文" X="985" Y="2308" WIDTH="70" HEIGHT="698" CONF="0.771" ORDER="62" STRING="こびのいろおもてにあらりと" />
  <LINE TYPE="本文" X="928" Y="2224" WIDTH="64" HEIGHT="715" CONF="0.768" ORDER="63" STRING="なほよもやまをながむんに" />
  <LINE TYPE="本文" X="867" Y="2226" WIDTH="61" HEIGHT="670" CONF="0.810" ORDER="64" STRING="たにのあなだにらんまんと" />
  <LINE TYPE="本文" X="807" Y="2223" WIDTH="62" HEIGHT="674" CONF="0.818" ORDER="65" STRING="さきそふはなに目をこゞめ" />
  <LINE TYPE="本文" X="746" Y="2234" WIDTH="67" HEIGHT="667" CONF="0.798" ORDER="66" STRING="あくだむすにうちむかひ" />
  <LINE TYPE="本文" X="683" Y="2204" WIDTH="70" HEIGHT="728" CONF="0.786" ORDER="67" STRING="〽あれ見よかしこのたにこ" />
  <LINE TYPE="本文" X="621" Y="2266" WIDTH="65" HEIGHT="508" CONF="0.789" ORDER="68" STRING="さきそふはなはそ" />
  <LINE TYPE="本文" X="557" Y="2258" WIDTH="66" HEIGHT="650" CONF="0.791" ORDER="69" STRING="ふくいくとしてよのはなに" />
  <LINE TYPE="本文" X="494" Y="2270" WIDTH="64" HEIGHT="603" CONF="0.790" ORDER="70" STRING="しほまさるふぜいあり" />
  <LINE TYPE="本文" X="435" Y="2319" WIDTH="62" HEIGHT="547" CONF="0.688" ORDER="71" STRING="あれをひとえだを" />
  <LINE TYPE="本文" X="1050" Y="2580" WIDTH="60" HEIGHT="416" CONF="0.390" ORDER="72" STRING="をなぐさめよろで" />
  <LINE TYPE="本文" X="363" Y="2347" WIDTH="69" HEIGHT="471" CONF="0.711" ORDER="73" STRING="とりてよけふのはな" />
  <LINE TYPE="本文" X="354" Y="2833" WIDTH="65" HEIGHT="149" CONF="0.393" ORDER="74" STRING="つぎん" />
