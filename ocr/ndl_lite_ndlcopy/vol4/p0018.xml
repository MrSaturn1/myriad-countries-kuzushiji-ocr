  <LINE TYPE="本文" X="4186" Y="685" WIDTH="56" HEIGHT="322" CONF="0.406" ORDER="0" STRING="つく清二" />
  <LINE TYPE="本文" X="4087" Y="333" WIDTH="83" HEIGHT="928" CONF="0.853" ORDER="1" STRING="つゞきかんじてこのものなりせばわが" />
  <LINE TYPE="本文" X="4017" Y="334" WIDTH="79" HEIGHT="972" CONF="0.841" ORDER="2" STRING="いへをゆづりてよろしさはあれかれには" />
  <LINE TYPE="本文" X="3960" Y="344" WIDTH="71" HEIGHT="900" CONF="0.842" ORDER="3" STRING="はゝあればむこにとらんとなすこと" />
  <LINE TYPE="本文" X="3900" Y="339" WIDTH="67" HEIGHT="933" CONF="0.837" ORDER="4" STRING="かたしとそのまくおもひとゞまりしが" />
  <LINE TYPE="本文" X="3839" Y="344" WIDTH="69" HEIGHT="914" CONF="0.844" ORDER="5" STRING="いまはおれが身ひとつなればうけ" />
  <LINE TYPE="本文" X="3778" Y="335" WIDTH="71" HEIGHT="977" CONF="0.815" ORDER="6" STRING="ひくこともあらんかとてある日あゝだ" />
  <LINE TYPE="本文" X="3719" Y="338" WIDTH="75" HEIGHT="1019" CONF="0.832" ORDER="7" STRING="むすをうちまねきしつ〳〵のよしいひ" />
  <LINE TYPE="本文" X="3652" Y="333" WIDTH="78" HEIGHT="1039" CONF="0.836" ORDER="8" STRING="きけるにあゝだむすはこれをぢし〽いや" />
  <LINE TYPE="本文" X="3593" Y="326" WIDTH="73" HEIGHT="1035" CONF="0.813" ORDER="9" STRING="しきどみんのやつがれを大せうくわんの" />
  <LINE TYPE="本文" X="3537" Y="335" WIDTH="71" HEIGHT="1020" CONF="0.806" ORDER="10" STRING="むこがねにめさるゝことはめうがなけれど" />
  <LINE TYPE="本文" X="3471" Y="334" WIDTH="75" HEIGHT="1039" CONF="0.800" ORDER="11" STRING="くみしたのさとびとらがもしやつがれの" />
  <LINE TYPE="本文" X="3414" Y="336" WIDTH="68" HEIGHT="869" CONF="0.801" ORDER="12" STRING="けぢをうけずばせうくわんの名" />
  <LINE TYPE="本文" X="3350" Y="324" WIDTH="73" HEIGHT="937" CONF="0.809" ORDER="13" STRING="をれにしてのちにこうくわいし給ふ" />
  <LINE TYPE="本文" X="3294" Y="321" WIDTH="72" HEIGHT="935" CONF="0.835" ORDER="14" STRING="べしこのきはひらにみゆるしありて" />
  <LINE TYPE="本文" X="3237" Y="324" WIDTH="67" HEIGHT="882" CONF="0.802" ORDER="15" STRING="こみふんにつりあふむこをさがさ" />
  <LINE TYPE="本文" X="3178" Y="332" WIDTH="68" HEIGHT="934" CONF="0.805" ORDER="16" STRING="せ給へといひけるにぞマヂサはいよ〳〵" />
  <LINE TYPE="本文" X="3116" Y="329" WIDTH="71" HEIGHT="921" CONF="0.847" ORDER="17" STRING="かんげきしてなほとのましくおもふ" />
  <LINE TYPE="本文" X="3056" Y="324" WIDTH="72" HEIGHT="903" CONF="0.840" ORDER="18" STRING="ものからしあんをさだめていへるやう" />
  <LINE TYPE="本文" X="2996" Y="324" WIDTH="71" HEIGHT="879" CONF="0.838" ORDER="19" STRING="しからばわれらがくみしたのもの" />
  <LINE TYPE="本文" X="2935" Y="319" WIDTH="73" HEIGHT="895" CONF="0.841" ORDER="20" STRING="どもがいちどうにとくしんなさば" />
  <LINE TYPE="本文" X="2875" Y="318" WIDTH="73" HEIGHT="947" CONF="0.840" ORDER="21" STRING="むこがねになりて給はるこゝろなりや" />
  <LINE TYPE="本文" X="2814" Y="313" WIDTH="69" HEIGHT="991" CONF="0.812" ORDER="22" STRING="そのことをきかまほしととふにこなたは" />
  <LINE TYPE="本文" X="2752" Y="319" WIDTH="72" HEIGHT="1029" CONF="0.792" ORDER="23" STRING="いちぎにおよばず〽やつがれ身ぶんい中" />
  <LINE TYPE="本文" X="2632" Y="318" WIDTH="68" HEIGHT="1118" CONF="0.773" ORDER="24" STRING="たてまつれどもしやつがれがげぢをうけんと" />
  <LINE TYPE="本文" X="2570" Y="307" WIDTH="73" HEIGHT="1087" CONF="0.761" ORDER="25" STRING="いちどうのものとくどうなさばこのみの" />
  <LINE TYPE="本文" X="2501" Y="313" WIDTH="80" HEIGHT="961" CONF="0.836" ORDER="26" STRING="さいはひこの身にすぎずなにとて" />
  <LINE TYPE="本文" X="2439" Y="327" WIDTH="70" HEIGHT="770" CONF="0.843" ORDER="27" STRING="いなみたてまつらんといふに" />
  <LINE TYPE="本文" X="2688" Y="322" WIDTH="74" HEIGHT="1184" CONF="0.763" ORDER="28" STRING="ければひとのきふくせざるをはぢてかくはいなみ" />
