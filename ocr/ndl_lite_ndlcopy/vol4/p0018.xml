  <LINE TYPE="本文" X="1773" Y="320" WIDTH="68" HEIGHT="678" CONF="0.838" ORDER="32" STRING="なす三十六かそんのたみを" />
  <LINE TYPE="本文" X="1717" Y="314" WIDTH="59" HEIGHT="658" CONF="0.853" ORDER="33" STRING="まねぎ〽こたびわれらが" />
  <LINE TYPE="本文" X="1654" Y="316" WIDTH="65" HEIGHT="645" CONF="0.804" ORDER="34" STRING="めがねによりてあだ" />
