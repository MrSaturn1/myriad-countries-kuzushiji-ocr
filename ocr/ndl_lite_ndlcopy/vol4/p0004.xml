  <LINE TYPE="本文" X="1984" Y="1643" WIDTH="100" HEIGHT="1430" CONF="0.823" ORDER="11" STRING="一太祖二霊天より下降給ひ海水を尽りて" />
  <LINE TYPE="本文" X="1849" Y="1701" WIDTH="105" HEIGHT="1359" CONF="0.852" ORDER="12" STRING="以て国土を造建し玉ふ五大洲中開拓人" />
  <LINE TYPE="本文" X="1713" Y="1694" WIDTH="100" HEIGHT="1384" CONF="0.854" ORDER="13" STRING="一烟の年暦。頗る遅速ありと雖皆凡" />
  <LINE TYPE="本文" X="1582" Y="1699" WIDTH="97" HEIGHT="1381" CONF="0.856" ORDER="14" STRING="弟にして日月父母たるの正理豈異ること有" />
  <LINE TYPE="本文" X="1451" Y="1681" WIDTH="105" HEIGHT="1394" CONF="0.857" ORDER="15" STRING="らんや。閣龍氏新世界を検出し。墨利屈氏" />
  <LINE TYPE="本文" X="1318" Y="1657" WIDTH="96" HEIGHT="1412" CONF="0.857" ORDER="16" STRING="次で全州成れり。南北亜墨利加則ち是なり。" />
  <LINE TYPE="本文" X="1186" Y="1662" WIDTH="101" HEIGHT="1405" CONF="0.826" ORDER="17" STRING="而て西客此地に至り。人種盛んに産業そな" />
  <LINE TYPE="本文" X="1058" Y="1643" WIDTH="101" HEIGHT="1426" CONF="0.825" ORDER="18" STRING="はり。物として足ざるなし。茲に北洲合衆国人詰" />
  <LINE TYPE="本文" X="924" Y="1611" WIDTH="103" HEIGHT="1456" CONF="0.852" ORDER="19" STRING="聖東業阿尓熱なる者。性三徳を兼備し。忠" />
  <LINE TYPE="本文" X="786" Y="1602" WIDTH="100" HEIGHT="1453" CONF="0.828" ORDER="20" STRING="には生命を顧ず。政には国體を失はず遂に英国の" />
  <LINE TYPE="本文" X="662" Y="1517" WIDTH="92" HEIGHT="1543" CONF="0.765" ORDER="21" STRING="苛政を脱さしめ。独立建国の威を後世に伝ふるに至り" />
  <LINE TYPE="本文" X="530" Y="1460" WIDTH="101" HEIGHT="1528" CONF="0.790" ORDER="22" STRING="其功業を稗史に綴りて。童蒙画説となすにとな" />
  <LINE TYPE="本文" X="403" Y="1521" WIDTH="104" HEIGHT="1375" CONF="0.700" ORDER="23" STRING="文久元辛酉秋仮名垣魯文誌" />
