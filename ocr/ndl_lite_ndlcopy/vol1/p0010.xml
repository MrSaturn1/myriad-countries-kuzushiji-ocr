<PAGE IMAGENAME="p0010.jpg" WIDTH="4596" HEIGHT="4401">
  <LINE TYPE="本文" X="2790" Y="474" WIDTH="89" HEIGHT="483" CONF="0.768" ORDER="0" STRING="英吉利国部" />
  <LINE TYPE="本文" X="2837" Y="965" WIDTH="66" HEIGHT="302" CONF="0.725" ORDER="1" STRING="○このくには" />
  <LINE TYPE="本文" X="2776" Y="983" WIDTH="55" HEIGHT="323" CONF="0.744" ORDER="2" STRING="ゑうらつぱ" />
  <LINE TYPE="本文" X="2705" Y="467" WIDTH="67" HEIGHT="846" CONF="0.815" ORDER="3" STRING="しうにしのかたのうみのなかにある" />
  <LINE TYPE="本文" X="2635" Y="467" WIDTH="68" HEIGHT="877" CONF="0.796" ORDER="4" STRING="ひとつのおほしまぐになりきたの" />
  <LINE TYPE="本文" X="2564" Y="470" WIDTH="71" HEIGHT="850" CONF="0.815" ORDER="5" STRING="かたのちをすこしやといふそのしま" />
  <LINE TYPE="本文" X="2492" Y="463" WIDTH="70" HEIGHT="871" CONF="0.820" ORDER="6" STRING="にはむかしよりぬしありてこれを" />
  <LINE TYPE="本文" X="2049" Y="508" WIDTH="88" HEIGHT="917" CONF="0.848" ORDER="7" STRING="りやうせりしかるにいぎりすの女も" />
  <LINE TYPE="本文" X="1986" Y="495" WIDTH="79" HEIGHT="1003" CONF="0.832" ORDER="8" STRING="あんなの世にあたりてそのちをあはせ" />
  <LINE TYPE="本文" X="1920" Y="504" WIDTH="81" HEIGHT="1021" CONF="0.833" ORDER="9" STRING="又にしのかたにあるいるらんどゝいふしま" />
  <LINE TYPE="本文" X="1856" Y="501" WIDTH="80" HEIGHT="1031" CONF="0.840" ORDER="10" STRING="をもりやうぶんとしてくにの名を大ぶり" />
  <LINE TYPE="本文" X="1789" Y="504" WIDTH="81" HEIGHT="1000" CONF="0.837" ORDER="11" STRING="たにやといふそのくにのとちをわけて" />
  <LINE TYPE="本文" X="1718" Y="503" WIDTH="81" HEIGHT="850" CONF="0.824" ORDER="12" STRING="十二かこくとなくこれに六十二の" />
  <LINE TYPE="本文" X="1642" Y="501" WIDTH="89" HEIGHT="872" CONF="0.755" ORDER="13" STRING="たいめりをほうずそのみなみの" />
  <LINE TYPE="本文" X="1573" Y="503" WIDTH="82" HEIGHT="785" CONF="0.745" ORDER="14" STRING="かたはからいすといへるうみの" />
  <LINE TYPE="本文" X="1509" Y="492" WIDTH="90" HEIGHT="864" CONF="0.778" ORDER="15" STRING="けわしきやまをへだちておらんだ" />
  <LINE TYPE="本文" X="1446" Y="495" WIDTH="82" HEIGHT="855" CONF="0.793" ORDER="16" STRING="ふらんすのりやうこくにむかひ" />
  <LINE TYPE="本文" X="1379" Y="502" WIDTH="75" HEIGHT="683" CONF="0.815" ORDER="17" STRING="あふそのあひだへだゝること" />
  <LINE TYPE="本文" X="1310" Y="508" WIDTH="70" HEIGHT="243" CONF="0.740" ORDER="18" STRING="わづかに" />
  <LINE TYPE="本文" X="1240" Y="508" WIDTH="63" HEIGHT="197" CONF="0.683" ORDER="19" STRING="十二三り" />
  <LINE TYPE="本文" X="1180" Y="511" WIDTH="52" HEIGHT="151" CONF="0.534" ORDER="20" STRING="よき" />
<LINE TYPE="本文" X="1104" Y="507" WIDTH="70" HEIGHT="99" CONF="0.628" ORDER="21" STRING="かぜ" />
  <LINE TYPE="本文" X="1018" Y="508" WIDTH="74" HEIGHT="105" CONF="0.602" ORDER="22" STRING="に" />
  <LINE TYPE="本文" X="787" Y="502" WIDTH="76" HEIGHT="470" CONF="0.803" ORDER="23" STRING="ほをあげて" />
  <LINE TYPE="本文" X="715" Y="511" WIDTH="70" HEIGHT="643" CONF="0.768" ORDER="24" STRING="ふねをはしらするときは" />
  <LINE TYPE="本文" X="647" Y="497" WIDTH="68" HEIGHT="648" CONF="0.792" ORDER="25" STRING="いちにちにしておうらい" />
  <LINE TYPE="本文" X="575" Y="498" WIDTH="67" HEIGHT="913" CONF="0.779" ORDER="26" STRING="するなりいにしへよりそのくにの王は" />
  <LINE TYPE="本文" X="510" Y="496" WIDTH="61" HEIGHT="931" CONF="0.794" ORDER="27" STRING="をとこなるときもあり女のこともあり" />
  <LINE TYPE="本文" X="434" Y="501" WIDTH="67" HEIGHT="928" CONF="0.802" ORDER="28" STRING="てさだまらずたうじは女王にて" />
  </PAGE>

