  <LINE TYPE="本文" X="1889" Y="841" WIDTH="130" HEIGHT="2327" CONF="0.848" ORDER="12" STRING="梅松愛させ給ふ菅神の詠歌に。海と山千里を隔すむ人も。" />
  <LINE TYPE="本文" X="1737" Y="840" WIDTH="131" HEIGHT="2326" CONF="0.861" ORDER="13" STRING="物言かはす文字の機とつらね給ひしも宜なる哉文化盛興" />
  <LINE TYPE="本文" X="1570" Y="824" WIDTH="131" HEIGHT="2368" CONF="0.849" ORDER="14" STRING="の徳たる。居ながらにして。海外萬里の情態を精通し臥寐て" />
  <LINE TYPE="本文" X="1398" Y="822" WIDTH="131" HEIGHT="2367" CONF="0.846" ORDER="15" STRING="諸蛮の治乱を覈明す。泰平の恩沢。仰尊むべきことになん" />
  <LINE TYPE="本文" X="1237" Y="836" WIDTH="134" HEIGHT="2326" CONF="0.876" ORDER="16" STRING="然と雖。漢蘭の異文外藩の宇音我童蒙婦女の為に" />
  <LINE TYPE="本文" X="1064" Y="827" WIDTH="141" HEIGHT="2346" CONF="0.856" ORDER="17" STRING="一読安からず。茲に於て。皇国仮宇に解和げ。万里外の情" />
  <LINE TYPE="本文" X="911" Y="837" WIDTH="126" HEIGHT="2329" CONF="0.824" ORDER="18" STRING="一景を諸書の中より抜翠して万国話と号るものは。春日" />
  <LINE TYPE="本文" X="734" Y="837" WIDTH="145" HEIGHT="1816" CONF="0.795" ORDER="19" STRING="一秋夜の長きに倦の。御伽草紙といはまく而已" />
