<OCRDATASET>
<PAGE IMAGENAME="p0019.jpg" WIDTH="4582" HEIGHT="4316">
  <LINE TYPE="本文" X="4155" Y="582" WIDTH="68" HEIGHT="1278" CONF="0.810" ORDER="0" STRING="〇およそあめつかはものにかたありてもとれをつくることを" />
  <LINE TYPE="本文" X="4090" Y="583" WIDTH="68" HEIGHT="1229" CONF="0.801" ORDER="1" STRING="しらざればほうのくによりつくるものをよびよせてくにの" />
  <LINE TYPE="本文" X="4019" Y="582" WIDTH="72" HEIGHT="1167" CONF="0.853" ORDER="2" STRING="うちのひと〴〵にならはせをしゆるなり又つくることを" />
  <LINE TYPE="本文" X="3948" Y="583" WIDTH="71" HEIGHT="1162" CONF="0.847" ORDER="3" STRING="しるものありても人のちからなければみつのちから" />
  <LINE TYPE="本文" X="3878" Y="585" WIDTH="72" HEIGHT="1179" CONF="0.837" ORDER="4" STRING="火のちからけものゝちからをかりてこれをつくるわたを" />
  <LINE TYPE="本文" X="3805" Y="586" WIDTH="76" HEIGHT="1167" CONF="0.814" ORDER="5" STRING="ぬのにおるにみづのちかうをもつておりいだすその" />
  <LINE TYPE="本文" X="3730" Y="573" WIDTH="79" HEIGHT="1242" CONF="0.794" ORDER="6" STRING="ほるは。小女たちの手にておるなりそのしな五分の一を" />
  <LINE TYPE="本文" X="3670" Y="584" WIDTH="66" HEIGHT="1056" CONF="0.724" ORDER="7" STRING="くにゝとゞめてそのよはたとくへありさばく也" />
  <LINE TYPE="本文" X="3604" Y="585" WIDTH="69" HEIGHT="933" CONF="0.810" ORDER="8" STRING="らしやをおるにもみづのちからをかりて" />
  <LINE TYPE="本文" X="3541" Y="584" WIDTH="66" HEIGHT="622" CONF="0.847" ORDER="9" STRING="せいすなりせとものはくにの" />
  <LINE TYPE="本文" X="3949" Y="1820" WIDTH="63" HEIGHT="199" CONF="0.325" ORDER="10" STRING="□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□□" />
<LINE TYPE="本文" X="3474" Y="584" WIDTH="66" HEIGHT="633" CONF="0.870" ORDER="11" STRING="うちにつちありてつくると" />
  <LINE TYPE="本文" X="3407" Y="582" WIDTH="65" HEIGHT="614" CONF="0.860" ORDER="12" STRING="いへどもからにはおよばすへ" />
  <LINE TYPE="本文" X="3342" Y="581" WIDTH="64" HEIGHT="605" CONF="0.874" ORDER="13" STRING="しよもめばん木はいたつて" />
  <LINE TYPE="本文" X="3272" Y="581" WIDTH="69" HEIGHT="636" CONF="0.875" ORDER="14" STRING="おほしみな正はんをもちひ" />
  <LINE TYPE="本文" X="3197" Y="578" WIDTH="72" HEIGHT="651" CONF="0.869" ORDER="15" STRING="ずみなどうばんをもちゆる" />
  <LINE TYPE="本文" X="3124" Y="575" WIDTH="72" HEIGHT="655" CONF="0.855" ORDER="16" STRING="このゆにもじのゐものし" />
  <LINE TYPE="本文" X="3056" Y="578" WIDTH="73" HEIGHT="587" CONF="0.852" ORDER="17" STRING="かみすきはんしたかきの" />
  <LINE TYPE="本文" X="2991" Y="580" WIDTH="68" HEIGHT="606" CONF="0.811" ORDER="18" STRING="たくひはなはだおほしとぞ" />
  <LINE TYPE="本文" X="2923" Y="581" WIDTH="68" HEIGHT="585" CONF="0.849" ORDER="19" STRING="〇かづしゆうこくのみやこ" />
  <LINE TYPE="本文" X="2843" Y="584" WIDTH="79" HEIGHT="308" CONF="0.645" ORDER="20" STRING="には都城" />
  <LINE TYPE="本文" X="2774" Y="585" WIDTH="68" HEIGHT="304" CONF="0.835" ORDER="21" STRING="官ほありて" />
  <LINE TYPE="本文" X="2854" Y="841" WIDTH="65" HEIGHT="137" CONF="0.330" ORDER="22" STRING="やうの" />
  <LINE TYPE="本文" X="2713" Y="585" WIDTH="59" HEIGHT="323" CONF="0.789" ORDER="23" STRING="とうりやうを" />
  <LINE TYPE="本文" X="2642" Y="587" WIDTH="65" HEIGHT="318" CONF="0.813" ORDER="24" STRING="ひとりづゝまた" />
  <LINE TYPE="本文" X="2563" Y="597" WIDTH="68" HEIGHT="298" CONF="0.832" ORDER="25" STRING="ふくしやうを" />
  <LINE TYPE="本文" X="2492" Y="590" WIDTH="65" HEIGHT="313" CONF="0.818" ORDER="26" STRING="ひとりづゝその" />
  <LINE TYPE="本文" X="2084" Y="595" WIDTH="71" HEIGHT="609" CONF="0.831" ORDER="27" STRING="夜のやくにんはいくにんと" />
  <LINE TYPE="本文" X="2020" Y="591" WIDTH="65" HEIGHT="758" CONF="0.844" ORDER="28" STRING="さだめなじやくしよにはとうりやう" />
  <LINE TYPE="本文" X="1951" Y="585" WIDTH="67" HEIGHT="756" CONF="0.842" ORDER="29" STRING="ふくしやうおよびひやくしやうまで" />
  <LINE TYPE="本文" X="1883" Y="590" WIDTH="66" HEIGHT="646" CONF="0.876" ORDER="30" STRING="もひやうぎするみろあり" />
  <LINE TYPE="本文" X="1812" Y="586" WIDTH="71" HEIGHT="668" CONF="0.898" ORDER="31" STRING="せいじにおいては大小のさべつ" />
  <LINE TYPE="本文" X="1745" Y="585" WIDTH="67" HEIGHT="688" CONF="0.891" ORDER="32" STRING="なくおの〳〵世人くわいがふして" />
  <LINE TYPE="本文" X="1676" Y="584" WIDTH="70" HEIGHT="696" CONF="0.887" ORDER="33" STRING="ひやうぎのうへほどこしおこなふ" />
  <LINE TYPE="本文" X="1610" Y="581" WIDTH="68" HEIGHT="705" CONF="0.882" ORDER="34" STRING="もし又どういせざることも十人の" />
  <LINE TYPE="本文" X="1546" Y="580" WIDTH="68" HEIGHT="702" CONF="0.864" ORDER="35" STRING="うち六七人どういのものあら" />
  <LINE TYPE="本文" X="1483" Y="581" WIDTH="69" HEIGHT="692" CONF="0.866" ORDER="36" STRING="ばそれときめてしまふ也みや" />
  <LINE TYPE="本文" X="1412" Y="580" WIDTH="74" HEIGHT="692" CONF="0.860" ORDER="37" STRING="このうちには一人の大とらりやう" />
  <LINE TYPE="本文" X="1338" Y="579" WIDTH="77" HEIGHT="689" CONF="0.868" ORDER="38" STRING="ありてくにのぬしとなり一人" />
  <LINE TYPE="本文" X="709" Y="577" WIDTH="68" HEIGHT="981" CONF="0.822" ORDER="39" STRING="そへとろもやうありてたすけとなりぬ右の" />
  <LINE TYPE="本文" X="644" Y="578" WIDTH="71" HEIGHT="969" CONF="0.832" ORDER="40" STRING="ふたりはおほせいののものゝえらびによりて" />
  <LINE TYPE="本文" X="574" Y="579" WIDTH="76" HEIGHT="1023" CONF="0.794" ORDER="41" STRING="もちゆるなりこのしよくにいたるもの年三十五" />
  <LINE TYPE="本文" X="499" Y="578" WIDTH="83" HEIGHT="1148" CONF="0.800" ORDER="42" STRING="いじやうにおよびこのくにしゆつせうのひとにあら" />
  <LINE TYPE="本文" X="408" Y="565" WIDTH="96" HEIGHT="1281" CONF="0.780" ORDER="43" STRING="ざればこのしよくにんずることをゆるさず四年をつぎへ" />
  </PAGE>

