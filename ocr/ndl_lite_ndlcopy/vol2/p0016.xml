<PAGE IMAGENAME="p0016.jpg" WIDTH="4582" HEIGHT="4316">
  <LINE TYPE="本文" X="4157" Y="579" WIDTH="69" HEIGHT="642" CONF="0.782" ORDER="0" STRING="つゞきおらんだとうしよ" />
  <LINE TYPE="本文" X="4088" Y="579" WIDTH="70" HEIGHT="617" CONF="0.847" ORDER="1" STRING="こゝの人むれをなして日々" />
  <LINE TYPE="本文" X="4017" Y="577" WIDTH="75" HEIGHT="646" CONF="0.868" ORDER="2" STRING="に人ンべつのかずふへとうじ" />
  <LINE TYPE="本文" X="3952" Y="574" WIDTH="73" HEIGHT="662" CONF="0.867" ORDER="3" STRING="は二千万人にあまれりとぞ" />
  <LINE TYPE="本文" X="3881" Y="577" WIDTH="70" HEIGHT="616" CONF="0.894" ORDER="4" STRING="またそのちのさまはわけて" />
  <LINE TYPE="本文" X="3813" Y="577" WIDTH="69" HEIGHT="584" CONF="0.846" ORDER="5" STRING="全洲焼を三つとなす" />
  <LINE TYPE="本文" X="3744" Y="580" WIDTH="74" HEIGHT="601" CONF="0.862" ORDER="6" STRING="ひがし○あたらんちせ海を" />
  <LINE TYPE="本文" X="3678" Y="578" WIDTH="68" HEIGHT="615" CONF="0.860" ORDER="7" STRING="さることすじうりにして" />
  <LINE TYPE="本文" X="3616" Y="572" WIDTH="64" HEIGHT="644" CONF="0.859" ORDER="8" STRING="山ありみなみよりして北に" />
  <LINE TYPE="本文" X="3549" Y="572" WIDTH="67" HEIGHT="714" CONF="0.860" ORDER="9" STRING="わたりそのけいしよくのうつく" />
  <LINE TYPE="本文" X="3487" Y="576" WIDTH="61" HEIGHT="716" CONF="0.852" ORDER="10" STRING="しきことゑにかきたるがごとく" />
  <LINE TYPE="本文" X="3346" Y="567" WIDTH="78" HEIGHT="755" CONF="0.848" ORDER="11" STRING="一分とすひがし大へい海をさる" />
  <LINE TYPE="本文" X="3279" Y="576" WIDTH="68" HEIGHT="626" CONF="0.878" ORDER="12" STRING="ことす十里にしてみねあり" />
  <LINE TYPE="本文" X="3206" Y="575" WIDTH="74" HEIGHT="664" CONF="0.859" ORDER="13" STRING="北よりみなみにわたるその" />
  <LINE TYPE="本文" X="3135" Y="575" WIDTH="75" HEIGHT="586" CONF="0.876" ORDER="14" STRING="ありさまいとをひきたる" />
  <LINE TYPE="本文" X="3066" Y="575" WIDTH="69" HEIGHT="546" CONF="0.886" ORDER="15" STRING="にことならずこのみね" />
  <LINE TYPE="本文" X="2997" Y="578" WIDTH="71" HEIGHT="563" CONF="0.874" ORDER="16" STRING="よりいせんの山にいたる" />
  <LINE TYPE="本文" X="2920" Y="577" WIDTH="82" HEIGHT="561" CONF="0.860" ORDER="17" STRING="を一分となすいはゆる" />
  <LINE TYPE="本文" X="3417" Y="572" WIDTH="69" HEIGHT="744" CONF="0.850" ORDER="18" STRING="この山よりくつみにいたるまでを" />
  <LINE TYPE="本文" X="2848" Y="577" WIDTH="70" HEIGHT="571" CONF="0.855" ORDER="19" STRING="三分なりこれよりひがし" />
  <LINE TYPE="本文" X="2779" Y="580" WIDTH="67" HEIGHT="488" CONF="0.865" ORDER="20" STRING="きたみなきはまべに" />
  <LINE TYPE="本文" X="2706" Y="578" WIDTH="74" HEIGHT="508" CONF="0.862" ORDER="21" STRING="そふてゆけばしだいに" />
  <LINE TYPE="本文" X="2633" Y="577" WIDTH="73" HEIGHT="539" CONF="0.849" ORDER="22" STRING="ひろくそのひがしきたの" />
  <LINE TYPE="本文" X="2563" Y="576" WIDTH="69" HEIGHT="493" CONF="0.835" ORDER="23" STRING="すみは山とうみづら" />
  <LINE TYPE="本文" X="2494" Y="580" WIDTH="71" HEIGHT="586" CONF="0.814" ORDER="24" STRING="なりてすこしもちのあま" />
  <LINE TYPE="本文" X="2104" Y="602" WIDTH="73" HEIGHT="656" CONF="0.782" ORDER="25" STRING="りなしひがしみなみはたひら" />
  <LINE TYPE="本文" X="2033" Y="604" WIDTH="76" HEIGHT="654" CONF="0.795" ORDER="26" STRING="かなるところあり山河か" />
  <LINE TYPE="本文" X="1966" Y="604" WIDTH="75" HEIGHT="663" CONF="0.833" ORDER="27" STRING="ならび山のいたゞきにたき" />
  <LINE TYPE="本文" X="1900" Y="605" WIDTH="72" HEIGHT="628" CONF="0.841" ORDER="28" STRING="ありそのにしにある山の" />
  <LINE TYPE="本文" X="1831" Y="606" WIDTH="72" HEIGHT="639" CONF="0.777" ORDER="29" STRING="たかさ一丈ばかりなり太平" />
  <LINE TYPE="本文" X="1760" Y="601" WIDTH="77" HEIGHT="627" CONF="0.830" ORDER="31" STRING="かいとへだゝること千五百" />
  <LINE TYPE="本文" X="1694" Y="604" WIDTH="73" HEIGHT="591" CONF="0.792" ORDER="32" STRING="よりおよそ河水三分の" />
  <LINE TYPE="本文" X="1628" Y="603" WIDTH="76" HEIGHT="578" CONF="0.835" ORDER="33" STRING="太平かいにながれいる" />
  <LINE TYPE="本文" X="1563" Y="610" WIDTH="68" HEIGHT="569" CONF="0.835" ORDER="34" STRING="ものこの山中をめぐると" />
  <LINE TYPE="本文" X="1497" Y="609" WIDTH="68" HEIGHT="584" CONF="0.837" ORDER="35" STRING="いふこのくにみなみきた" />
  <LINE TYPE="本文" X="1428" Y="610" WIDTH="68" HEIGHT="597" CONF="0.821" ORDER="36" STRING="によりてさむきあつき" />
  <LINE TYPE="本文" X="1364" Y="606" WIDTH="67" HEIGHT="644" CONF="0.794" ORDER="37" STRING="おなじからずきたのかたは" />
  <LINE TYPE="本文" X="1296" Y="606" WIDTH="72" HEIGHT="718" CONF="0.793" ORDER="38" STRING="はなはださむくやうやくみな" />
  <LINE TYPE="本文" X="1225" Y="607" WIDTH="76" HEIGHT="785" CONF="0.843" ORDER="39" STRING="みへゆけばあつしでんぢなども" />
  <LINE TYPE="本文" X="1154" Y="604" WIDTH="75" HEIGHT="841" CONF="0.855" ORDER="40" STRING="そのごとくきたのかたはときによりて" />
  <LINE TYPE="本文" X="1091" Y="606" WIDTH="69" HEIGHT="842" CONF="0.819" ORDER="41" STRING="かうさくすべしみなみのかたはかう" />
  <LINE TYPE="本文" X="1030" Y="607" WIDTH="71" HEIGHT="831" CONF="0.853" ORDER="42" STRING="ずいのうれひありきたのかたの" />
  <LINE TYPE="本文" X="963" Y="600" WIDTH="73" HEIGHT="839" CONF="0.870" ORDER="43" STRING="とちはまいとし四五月ごろまでは" />
  <LINE TYPE="本文" X="898" Y="601" WIDTH="72" HEIGHT="811" CONF="0.852" ORDER="44" STRING="ゆきありちうわうのとちはまい" />
  <LINE TYPE="本文" X="827" Y="602" WIDTH="77" HEIGHT="821" CONF="0.856" ORDER="45" STRING="ねんゆきじもすくなくしてみなみ" />
  <LINE TYPE="本文" X="761" Y="607" WIDTH="73" HEIGHT="724" CONF="0.839" ORDER="46" STRING="のかたにちかつけばやうきはれ" />
  <LINE TYPE="本文" X="694" Y="611" WIDTH="73" HEIGHT="676" CONF="0.855" ORDER="47" STRING="あたゝかにしてときによりて" />
  <LINE TYPE="本文" X="627" Y="612" WIDTH="72" HEIGHT="780" CONF="0.831" ORDER="48" STRING="すゞむなりそうたはねんぢうの" />
  <LINE TYPE="本文" X="555" Y="609" WIDTH="76" HEIGHT="739" CONF="0.844" ORDER="49" STRING="四時おなじからずまいとしの" />
  <LINE TYPE="本文" X="486" Y="607" WIDTH="74" HEIGHT="771" CONF="0.846" ORDER="50" STRING="あつささむきまたことなりゆへ" />
  <LINE TYPE="本文" X="416" Y="592" WIDTH="78" HEIGHT="991" CONF="0.712" ORDER="51" STRING="によろづのものゝできはじかうのつきへ" />
  <LINE TYPE="本文" X="331" Y="924" WIDTH="61" HEIGHT="257" CONF="0.338" ORDER="52" STRING="テ目二" />
