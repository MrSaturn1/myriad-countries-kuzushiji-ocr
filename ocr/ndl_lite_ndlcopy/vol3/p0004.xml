<LINE TYPE="本文" X="1962" Y="965" WIDTH="132" HEIGHT="2023" CONF="0.820" ORDER="17" STRING="一漁義小説の本据たる。事を凡の近きに採て。義を勧懲" />
  <LINE TYPE="本文" X="1824" Y="910" WIDTH="127" HEIGHT="2078" CONF="0.841" ORDER="18" STRING="に発すをもて。編者の用意と為せるにこそ。莫適此書の" />
  <LINE TYPE="本文" X="1678" Y="913" WIDTH="142" HEIGHT="2067" CONF="0.834" ORDER="19" STRING="体載や。例の稗史の顰に做へど。寓言架空の話説を" />
  <LINE TYPE="本文" X="1543" Y="905" WIDTH="139" HEIGHT="2100" CONF="0.842" ORDER="20" STRING="設ず。蘭人葛拉墨兒氏が原訳たるを。清人の飜訳せし。" />
  <LINE TYPE="本文" X="1413" Y="921" WIDTH="134" HEIGHT="2081" CONF="0.836" ORDER="21" STRING="一海国図志を始とし。其他増訳采覧異言。或は亜墨" />
  <LINE TYPE="本文" X="1277" Y="897" WIDTH="143" HEIGHT="2093" CONF="0.839" ORDER="22" STRING="一利加一統志。西洋襍記の諸書に原き。童蒙婦幼に" />
  <LINE TYPE="本文" X="1142" Y="824" WIDTH="141" HEIGHT="2168" CONF="0.818" ORDER="23" STRING="見安くせんとて。皇国言葉を仮名文に。解和らげし珍説" />
  <LINE TYPE="本文" X="995" Y="984" WIDTH="142" HEIGHT="1995" CONF="0.842" ORDER="24" STRING="異聞。彼新国の事実を探りて。新板物の数に" />
  <LINE TYPE="本文" X="854" Y="978" WIDTH="145" HEIGHT="2006" CONF="0.836" ORDER="25" STRING="充るも。既に此度で三編目煙草呑間もあら沙婆" />
  <LINE TYPE="本文" X="699" Y="984" WIDTH="157" HEIGHT="1916" CONF="0.864" ORDER="26" STRING="の。作者と共に売出しを。梓の主が急ぎ侍りぬ" />
